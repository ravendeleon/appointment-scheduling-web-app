@model List<SchedulingApp.Models.Appointment>

@{
    ViewData["Title"] = "Calendar";
    DateTime selectedDate = ViewBag.SelectedDate;
    DateTime firstOfMonth = ViewBag.FirstOfMonth;
    DateTime lastOfMonth = ViewBag.LastOfMonth;
}

<h2>Calendar</h2>
<hr />

@* month navigation *@
<div class="d-flex align-items-center mb-3 gap-3">
    @{
        DateTime prevMonth = firstOfMonth.AddMonths(-1);
        DateTime nextMonth = firstOfMonth.AddMonths(1);
    }
    <a asp-action="Index" asp-route-selectedDate="@prevMonth.ToString("yyyy-MM-dd")"
       class="btn btn-outline-secondary">&laquo; Prev</a>

    <h4 class="mb-0">@ViewBag.CurrentMonth</h4>

    <a asp-action="Index" asp-route-selectedDate="@nextMonth.ToString("yyyy-MM-dd")"
       class="btn btn-outline-secondary">Next &raquo;</a>

    <a asp-action="Index" asp-route-selectedDate="@DateTime.Today.ToString("yyyy-MM-dd")"
       class="btn btn-outline-primary ms-2">Today</a>
</div>

@* calendar grid *@
<table class="table table-bordered text-center" style="table-layout: fixed;">
    <thead class="table-dark">
        <tr>
            <th>Sun</th>
            <th>Mon</th>
            <th>Tue</th>
            <th>Wed</th>
            <th>Thu</th>
            <th>Fri</th>
            <th>Sat</th>
        </tr>
    </thead>
    <tbody>
        @{
            int startBlank = (int)firstOfMonth.DayOfWeek;
            int totalDays = lastOfMonth.Day;
            int cellCount = 0;
        }
        <tr>
            @for (int i = 0; i < startBlank; i++)
            {
                <td class="bg-light"></td>
                cellCount++;
            }

            @for (int day = 1; day <= totalDays; day++)
            {
                DateTime cellDate = new DateTime(firstOfMonth.Year, firstOfMonth.Month, day);
                bool isSelected = cellDate.Date == selectedDate.Date;
                bool isToday = cellDate.Date == DateTime.Today;

                string cellClass = isSelected ? "table-primary fw-bold" :
                                   isToday ? "table-warning" : "";
                <td class="@cellClass" style="cursor:pointer; height:60px; vertical-align:top;">
                    <a asp-action="Index"
                           asp-route-selectedDate="@cellDate.ToString("yyyy-MM-dd")"
                           class="text-decoration-none text-dark d-block">
                        @day
                    </a>
                </td>
                cellCount++;

                @if (cellCount % 7 == 0 && day < totalDays)
                {
                    @Html.Raw("</tr><tr>")
                }
            }

            @while (cellCount % 7 != 0)
            {
                <td class="bg-light"></td>
                cellCount++;
            }
        </tr>
    </tbody>
</table>

@* appointments for the selected date *@
<div class="mt-4">
    <h5>
        Appointments for @selectedDate.ToString("MMMM d, yyyy")
        <span class="badge bg-secondary ms-2">@Model.Count</span>
    </h5>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">No appointments scheduled for this date.</div>
    }
    else
    {
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Appointment ID</th>
                    <th>Customer ID</th>
                    <th>Customer Name</th>
                    <th>Type</th>
                    <th>Start Time (Local)</th>
                    <th>End Time (Local)</th>
                    <th>User ID</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td>@a.AppointmentId</td>
                        <td>@a.CustomerId</td>
                        <td>@a.CustomerName</td>
                        <td>@a.Type</td>
                        <td>@a.StartLocal.ToString("M/d/yyyy h:mm tt")</td>
                        <td>@a.EndLocal.ToString("M/d/yyyy h:mm tt")</td>
                        <td>@a.UserId</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>