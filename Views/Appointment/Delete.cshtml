@model SchedulingApp.Models.Appointment

@{
    ViewData["Title"] = "Delete Appointment";
}

<h2>Delete Appointment</h2>
<hr />

<div class="alert alert-warning">
    Are you sure you want to delete this appointment?
</div>

<dl class="row" style="max-width: 400px;">
    <dt class="col-sm-4">Customer</dt>
    <dd class="col-sm-8">@Model.CustomerName</dd>
    <dt class="col-sm-4">Title</dt>
    <dd class="col-sm-8">@Model.Title</dd>
    <dt class="col-sm-4">Type</dt>
    <dd class="col-sm-8">@Model.Type</dd>
    <dt class="col-sm-4">Start</dt>
    <dd class="col-sm-8">@Model.StartLocal.ToString("M/d/yyyy h:mm tt")</dd>
    <dt class="col-sm-4">End</dt>
    <dd class="col-sm-8">@Model.EndLocal.ToString("M/d/yyyy h:mm tt")</dd>
</dl>

<form method="post" asp-action="Delete" asp-controller="Appointment">
    <input type="hidden" name="id" value="@Model.AppointmentId" />
    <button type="submit" class="btn btn-danger">Yes, Delete</button>
    <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
</form>