@{
    ViewData["Title"] = "Reports";
}

<h2>Reports</h2>
<hr />

@* report selection buttons *@
<div class="mb-4">
    <a asp-action="Index" asp-route-reportType="TypesByMonth"
           class="btn @(ViewBag.ReportType == "TypesByMonth" ? "btn-primary" : "btn-outline-primary") me-2">
        Appointment Types by Month
    </a>
    <a asp-action="Index" asp-route-reportType="ScheduleByUser"
           class="btn @(ViewBag.ReportType == "ScheduleByUser" ? "btn-primary" : "btn-outline-primary") me-2">
        Schedule by User
    </a>
    <a asp-action="Index" asp-route-reportType="ByCustomer"
           class="btn @(ViewBag.ReportType == "ByCustomer" ? "btn-primary" : "btn-outline-primary")">
        Appointments by Customer
    </a>
</div>

@if (ViewBag.ReportType != null)
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4>@ViewBag.ReportTitle</h4>
        @* timestamp shows when the report was generated *@
        <span class="text-muted small">Generated: @ViewBag.ReportTime</span>
    </div>

    @* search bar for the by customer report *@
    @if (ViewBag.ReportType == "ByCustomer")
    {
        <form method="get" class="mb-3">
            <input type="hidden" name="reportType" value="ByCustomer" />
            <div class="input-group" style="max-width: 400px;">
                <input type="text" class="form-control" name="search"
                       placeholder="Search by customer name"
                       value="@ViewBag.Search" />
                <button class="btn btn-outline-secondary" type="submit">Search</button>
                <a asp-action="Index" asp-route-reportType="ByCustomer"
                   class="btn btn-outline-danger">Clear</a>
            </div>
        </form>
    }

    @* report 1 - appointment types by month *@
    @if (ViewBag.ReportType == "TypesByMonth" && ViewBag.TypesByMonth != null)
    {
        var report = ViewBag.TypesByMonth as List<SchedulingApp.Models.TypeByMonthRow>;
        if (report.Count == 0)
        {
            <div class="alert alert-info">No appointments found.</div>
        }
        else
        {
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Month</th>
                        <th>Type</th>
                        <th>Count</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in report)
                    {
                        <tr>
                            <td>@row.Month</td>
                            <td>@row.Type</td>
                            <td>@row.Count</td>
                        </tr>
                    }
                </tbody>
            </table>
            <p class="text-muted small">@report.Count row(s)</p>
        }
    }

    @* report 2 - schedule by user *@
    @if (ViewBag.ReportType == "ScheduleByUser" && ViewBag.ScheduleByUser != null)
    {
        var report = ViewBag.ScheduleByUser as List<SchedulingApp.Models.UserScheduleRow>;
        if (report.Count == 0)
        {
            <div class="alert alert-info">No appointments found.</div>
        }
        else
        {
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>User</th>
                        <th>Appointment ID</th>
                        <th>Customer</th>
                        <th>Type</th>
                        <th>Start</th>
                        <th>End</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in report)
                    {
                        <tr>
                            <td>@row.UserName</td>
                            <td>@row.AppointmentId</td>
                            <td>@row.CustomerName</td>
                            <td>@row.Type</td>
                            <td>@row.StartLocal.ToString("M/d/yyyy h:mm tt")</td>
                            <td>@row.EndLocal.ToString("M/d/yyyy h:mm tt")</td>
                        </tr>
                    }
                </tbody>
            </table>
            <p class="text-muted small">@report.Count row(s)</p>
        }
    }

    @* report 3 - appointments by customer *@
    @if (ViewBag.ReportType == "ByCustomer" && ViewBag.ByCustomer != null)
    {
        var report = ViewBag.ByCustomer as List<SchedulingApp.Models.CustomerAppointmentCountRow>;
        if (report.Count == 0)
        {
            <div class="alert alert-info">No results found.</div>
        }
        else
        {
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Customer Name</th>
                        <th>Appointment Count</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in report)
                    {
                        <tr>
                            <td>@row.CustomerName</td>
                            <td>@row.Count</td>
                        </tr>
                    }
                </tbody>
            </table>
            <p class="text-muted small">@report.Count row(s)</p>
        }
    }
}
else
{
    <div class="alert alert-info">
        Select a report above to view results.
    </div>
}